#!/bin/sh

# Full test suite + 100% coverage gate before every push — the local counterpart of
# .github/workflows/tests.yml. `npm test` compiles the hand-written .ts sources, runs every test
# case and enforces 100% statements/lines/branches/functions on src/auth/offlineTokenProvider.ts
# and examples/synthesizeExample.ts, so a push can never carry an untested or uncovered change.
#
# Deliberately NOT part of .husky/pre-commit: the automated release invokes THAT hook directly
# (`make run_precommit_hooks`), where a test run over freshly generated code would break the release.
#
# To skip on purpose (e.g. sharing a work-in-progress branch):  git push --no-verify

set -e

# WHY THE GUARD BELOW: `make release` runs `make install_precommit_hooks` first, which points
# core.hooksPath at .husky/_ and thereby activates this hook, and then pushes three times, none of
# them with --no-verify:
#   git push                              (the "Preparing for Release <version>" commit)
#   git push -u origin release/<version>  (create_release_branch)
#   git push origin <version>             (create_release_tag)
# Re-testing freshly generated code there can abort the release AFTER the release commit but BEFORE
# `npm publish`, leaving a half-finished release behind. Git feeds the refs being pushed to this
# hook on stdin as "<local ref> <local sha> <remote ref> <remote sha>", so the release pushes are
# recognised and skipped: the release branch and the tag by their remote ref, the release commit by
# its subject.
while read -r _local_ref local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
  refs/tags/* | refs/heads/release/*)
    echo "pre-push: $remote_ref is a release ref -> skipping the test suite"
    exit 0
    ;;
  esac
  case "$(git log -1 --pretty=%s "$local_sha" 2>/dev/null)" in
  'Preparing for Release '*)
    echo 'pre-push: release commit detected -> skipping the test suite'
    exit 0
    ;;
  esac
done

npm test
